<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tax Invoice - <%= order.orderNumber || invoice.invoiceNumber %>
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @page {
            size: A4;
            margin: 5mm;
        }

        body {
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
            font-family: sans-serif;
            color: #000;
            font-size: 10px;
        }

        .invoice-container {
            width: 100%;
            max-width: 210mm;
            margin: 0 auto;
        }

        .border-invoice {
            border: 1px solid #000;
        }

        .border-b-invoice {
            border-bottom: 1px solid #000;
        }

        .border-r-invoice {
            border-right: 1px solid #000;
        }

        .border-l-invoice {
            border-left: 1px solid #000;
        }

        .border-t-invoice {
            border-top: 1px solid #000;
        }

        th,
        td {
            padding: 4px;
        }
    </style>
</head>

<body class="bg-white">

    <div class="invoice-container">
        <div class="border-invoice mb-2">
            <div class="text-center border-b-invoice py-1">
                <h1 class="text-lg font-bold">Tax Invoice</h1>
            </div>

            <!-- Header Row -->
            <div class="flex justify-between px-2 py-1 border-b-invoice">
                <div>Invoice Number : <span class="font-semibold">
                        <%= (typeof order !== 'undefined' && order && order.orderNumber) ? order.orderNumber : ((typeof invoice !== 'undefined' && invoice) ? invoice.invoiceNumber : '') %>
                    </span></div>
                <div>Date & Time : <span class="font-semibold">
                        <%= new Date(((typeof invoice !== 'undefined' && invoice) ? (invoice.createdAt || invoice.issueDate) : null) || ((typeof order !== 'undefined' && order) ? order.createdAt : null) || Date.now()).toLocaleString('en-IN') %>
                    </span></div>
            </div>

            <!-- 3 Column Details Row -->
            <div class="flex border-b-invoice">
                <!-- Seller Details -->
                <div class="w-1/3 border-r-invoice p-2">
                    <h2 class="font-bold text-xs uppercase">
                        <%= store.name || 'CARBONSMITH PVT LTD' %>
                    </h2>
                    <p class="mt-1">
                        <%= store.address
                            || 'Shop No. 7, Kunjir Shyama Prestige, Wing-A, Rahatani Rd, Pimple Saudagar, Pimpri-Chinchwad, Maharashtra 411027'
                            %>
                    </p>
                    <table class="mt-2 w-full">
                        <tbody>
                            <tr>
                                <td class="py-0.5 w-1/3">Sales Executive:</td>
                                <td class="py-0.5 font-semibold">
                                    <%= (typeof adminName !== 'undefined' && adminName) ? adminName : ((typeof staff !== 'undefined' && staff) ? staff.name : 'Admin') %>
                                </td>
                            </tr>
                            <tr>
                                <td class="py-0.5 w-1/3">Store Contact No:</td>
                                <td class="py-0.5">
                                    <%= store.phone || '020-69121427' %>
                                </td>
                            </tr>
                            <tr>
                                <td class="py-0.5">CIN:</td>
                                <td class="py-0.5">U32119PN2026PTC257070</td>
                            </tr>
                            <tr>
                                <td class="py-0.5">PAN:</td>
                                <td class="py-0.5">
                                    <%= store.pan || 'AANCC9664L' %>
                                </td>
                            </tr>
                            <tr>
                                <td class="py-0.5">GSTIN:</td>
                                <td class="py-0.5">
                                    <%= store.gstin || '27AANCC9664L1ZS' %>
                                </td>
                            </tr>
                            <tr>
                                <td class="py-0.5">Place of Supply:</td>
                                <td class="py-0.5">Pune, Maharashtra</td>
                            </tr>
                            <tr>
                                <td class="py-0.5">State Code:</td>
                                <td class="py-0.5">27</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Customer Details -->
                <div class="w-1/3 border-r-invoice p-2">
                    <% const shipAddr = (typeof shippingAddress !== 'undefined' && shippingAddress) ? shippingAddress : ((order && order.shippingAddress) ? order.shippingAddress : {}); %>
                    <h2 class="font-bold text-xs uppercase mb-1">Customer Details</h2>
                    <table class="w-full">
                        <tbody>
                            <tr>
                                <td class="py-0.5 w-1/3">Name:</td>
                                <td class="py-0.5 font-semibold">
                                    <%= (order.user && order.user.name) || (order.customer && order.customer.name) || shipAddr.name || 'Walk-in Customer' %>
                                </td>
                            </tr>
                            <tr>
                                <td class="py-0.5 align-top">Address:</td>
                                <td class="py-0.5">
                                    <%= (order.customer && order.customer.address) || shipAddr.addressLine1 || 'Not Provided' %>
                                        <%= shipAddr.city ? ', ' + shipAddr.city : '' %>
                                </td>
                            </tr>
                            <tr>
                                <td class="py-0.5">Customer ID:</td>
                                <td class="py-0.5">
                                    <%= (order.user && order.user.id) ? order.user.id.slice(-6).toUpperCase() : (order.customerId ? String(order.customerId).slice(-6).toUpperCase() : 'N/A') %>
                                </td>
                            </tr>
                            <tr>
                                <td class="py-0.5">Contact No:</td>
                                <td class="py-0.5">
                                    <%= (order.user && order.user.phone) || (order.customer && order.customer.phone) || shipAddr.phone || 'N/A' %>
                                </td>
                            </tr>
                            <tr>
                                <td class="py-0.5">Email ID:</td>
                                <td class="py-0.5">
                                    <%= (order.user && order.user.email) || (order.customer && order.customer.email) || 'N/A' %>
                                </td>
                            </tr>
                            <tr>
                                <td class="py-0.5">PAN ID:</td>
                                <td class="py-0.5">Not Mentioned</td>
                            </tr>
                            <tr>
                                <td class="py-0.5">GST NO:</td>
                                <td class="py-0.5">Not Mentioned</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Metal Rates -->
                <div class="w-1/3 p-2">
                    <table class="w-full text-xs">
                        <thead>
                            <tr>
                                <th class="text-left font-normal pb-1">Metal Type(Purity)</th>
                                <th class="text-right font-normal pb-1">Rs/Gram</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Gold 24KT</td>
                                <td class="text-right">
                                    <%= (typeof goldRates !=='undefined' && goldRates && goldRates.rate24k) ?
                                        goldRates.rate24k.toFixed(2) : '---' %>
                                </td>
                            </tr>
                            <tr>
                                <td>Gold 22KT</td>
                                <td class="text-right">
                                    <%= (typeof goldRates !=='undefined' && goldRates && goldRates.rate22k) ?
                                        goldRates.rate22k.toFixed(2) : '---' %>
                                </td>
                            </tr>
                            <tr>
                                <td>Gold 18KT</td>
                                <td class="text-right">
                                    <%= (typeof goldRates !=='undefined' && goldRates && goldRates.rate18k) ?
                                        goldRates.rate18k.toFixed(2) : '---' %>
                                </td>
                            </tr>
                            <tr>
                                <td>Gold 14KT</td>
                                <td class="text-right">
                                    <%= (typeof goldRates !=='undefined' && goldRates && goldRates.rate14k) ?
                                        goldRates.rate14k.toFixed(2) : '---' %>
                                </td>
                            </tr>
                            <tr>
                                <td>Platinum </td>
                                <td class="text-right">6661.37</td>
                            </tr>
                            <tr>
                                <td>Silver</td>
                                <td class="text-right">261.14</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Products Table -->
            <div class="border-b-invoice">
                <table class="w-full text-center text-[9px]">
                    <thead class="border-b-invoice">
                        <tr class="bg-gray-50">
                            <th class="border-r-invoice py-2 w-32">Item Description &<br />Serial Number</th>
                            <th class="border-r-invoice py-2">HSN/Purity</th>
                            <th class="border-r-invoice py-2">Metal Rate<br />(Rs.)</th>
                            <th class="border-r-invoice py-2">Qty (N)</th>
                            <th class="border-r-invoice py-2">Gross Wt (g)</th>
                            <th class="border-r-invoice py-2">Net Wt (g)</th>
                            <th class="border-r-invoice py-2">Stone Wt (carat)</th>
                            <th class="border-r-invoice py-2">Metal Value (<br />Rs.)</th>
                            <th class="border-r-invoice py-2">Stone Value (<br />Rs.)</th>
                            <th class="border-r-invoice py-2">Making<br />Charges (Rs.)</th>
                            <th class="border-r-invoice py-2">Gross Amount (<br />Rs.)</th>
                            <th class="py-2">Product Value (<br />Rs.)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% let totalGrossWt=0; let totalMetalWt=0; let totalStoneWt=0; let totalMetalValue=0; let
                            totalStoneValue=0; let totalMaking=0; let totalGrossAmount=0; let totalDiscount=0; let
                            taxableValue=0; if (order && order.items) { order.items.forEach(function(item) {
                            const product = item.product || {};
                            const metalDetails = product.metalDetails || {};
                            const netWeight = Number(metalDetails.netWeight || product.netWeight || item.netWeight || item.weight || 0);
                            const grossWeight = Number(metalDetails.grossWeight || product.grossWeight || item.grossWeight || 0);
                            
                            let stoneWeight = 0;
                            let unitStoneCharge = 0;
                            const stonesList = product.stoneDetails || product.stones || [];
                            if (stonesList && Array.isArray(stonesList) && stonesList.length > 0) {
                                stonesList.forEach(function(stone) {
                                    const caratVal = Number(stone.carat || 0);
                                    const weightVal = Number(stone.netWeight || stone.weight || 0);
                                    const calculationUnit = caratVal > 0 ? caratVal : weightVal;
                                    stoneWeight += calculationUnit;
                                    unitStoneCharge += (calculationUnit * Number(stone.rate || 0));
                                });
                            } else {
                                stoneWeight = Number(product.stoneDetails?.stoneWeight || product.stoneWeight || item.stoneWeight || 0);
                                unitStoneCharge = Number(product.stoneCharges || product.stoneDetails?.stoneCharges || item.stoneCharges || 0);
                            }
                            if (item.calculatedPrice && (item.calculatedPrice.stoneValue !== undefined && item.calculatedPrice.stoneValue !== null)) {
                                unitStoneCharge = Number(item.calculatedPrice.stoneValue);
                            }

                            let unitMakingCharge = 0;
                            if (product.makingChargeType === 'per_gram') {
                                unitMakingCharge = netWeight * Number(product.makingCharges || product.makingCharge || 0);
                            } else {
                                unitMakingCharge = Number(product.makingCharges || product.makingCharge || 0);
                            }
                            if (item.calculatedPrice && (item.calculatedPrice.originalMakingCharge || item.calculatedPrice.makingCharge)) {
                                unitMakingCharge = Number(item.calculatedPrice.originalMakingCharge || item.calculatedPrice.makingCharge);
                            } else if (item.makingCharge) {
                                unitMakingCharge = Number(item.makingCharge);
                            }

                            const qty = Number(item.quantity || 1);

                            const itemTotal = Number(item.totalPrice || product.price || 0) * qty;
                            const preTaxItemTotal = itemTotal / 1.03;

                            const unitMetalVal = (item.calculatedPrice?.metalValue !== undefined && item.calculatedPrice?.metalValue !== null)
                                ? Number(item.calculatedPrice.metalValue)
                                : (item.calculatedPrice?.goldValue !== undefined && item.calculatedPrice?.goldValue !== null)
                                    ? Number(item.calculatedPrice.goldValue)
                                    : (item.metalValue !== undefined && item.metalValue !== null)
                                        ? Number(item.metalValue)
                                        : (itemTotal > 0)
                                            ? ((preTaxItemTotal / qty) - unitMakingCharge - unitStoneCharge)
                                            : ((item.metalRate || item.goldRateAtTime || 0) * netWeight);

                            const metalVal = unitMetalVal * qty;
                            const stoneCharge = unitStoneCharge * qty;
                            const makingCharge = unitMakingCharge * qty;
                            const grossAmt = metalVal + makingCharge + stoneCharge;
                            const productVal = grossAmt;
                            const computedMetalRate = item.metalRate ? Number(item.metalRate) : (netWeight > 0 ? (unitMetalVal / netWeight) : 0);

                            totalGrossWt += grossWeight * qty;
                            totalMetalWt += netWeight * qty;
                            totalStoneWt += stoneWeight * qty;
                            totalMetalValue += metalVal;
                            totalStoneValue += stoneCharge;
                            totalMaking += makingCharge;
                            totalGrossAmount += grossAmt;
                            taxableValue += productVal;
                            %>
                            <tr class="border-b-invoice">
                                <td class="border-r-invoice text-left">
                                    <%= product.name || 'Custom Item' %><br />
                                        <%= product.sku || '' %>
                                </td>
                                <td class="border-r-invoice">
                                    <%= product.hsnCode || '71131912' %> / <%= metalDetails.purity || '22KT' %>
                                </td>
                                <td class="border-r-invoice">
                                    <%= computedMetalRate.toFixed(2) %>
                                </td>
                                <td class="border-r-invoice">
                                    <%= qty %>
                                </td>
                                <td class="border-r-invoice">
                                    <%= (grossWeight * qty).toFixed(3) %>
                                </td>
                                <td class="border-r-invoice">
                                    <%= (netWeight * qty).toFixed(3) %>
                                </td>
                                <td class="border-r-invoice">
                                    <%= (stoneWeight * qty).toFixed(3) %>
                                </td>
                                <td class="border-r-invoice">
                                    <%= metalVal.toFixed(2) %>
                                </td>
                                <td class="border-r-invoice">
                                    <%= stoneCharge.toFixed(2) %>
                                </td>
                                <td class="border-r-invoice">
                                    <%= makingCharge.toFixed(2) %>
                                </td>
                                <td class="border-r-invoice">
                                    <%= grossAmt.toFixed(2) %>
                                </td>
                                <td class="">
                                    <%= productVal.toFixed(2) %>
                                </td>
                            </tr>
                            <% }); } %>

                                <!-- Totals Row -->
                                <tr class="font-bold bg-gray-50">
                                    <td class="border-r-invoice text-right pr-4" colspan="3">Total</td>
                                    <td class="border-r-invoice">
                                        <%= order.items ? order.items.reduce((sum, item) => sum + (Number(item.quantity) || 1), 0) : 0 %>
                                    </td>
                                    <td class="border-r-invoice">
                                        <%= totalGrossWt.toFixed(3) %>
                                    </td>
                                    <td class="border-r-invoice">
                                        <%= totalMetalWt.toFixed(3) %>
                                    </td>
                                    <td class="border-r-invoice">
                                        <%= totalStoneWt.toFixed(3) %>
                                    </td>
                                    <td class="border-r-invoice">
                                        <%= totalMetalValue.toFixed(2) %>
                                    </td>
                                    <td class="border-r-invoice">
                                        <%= totalStoneValue.toFixed(2) %>
                                    </td>
                                    <td class="border-r-invoice">
                                        <%= totalMaking.toFixed(2) %>
                                    </td>
                                    <td class="border-r-invoice">
                                        <%= totalGrossAmount.toFixed(2) %>
                                    </td>
                                    <td class="">
                                        <%= totalGrossAmount.toFixed(2) %>
                                    </td>
                                </tr>
                    </tbody>
                </table>
            </div>

            <% 
                const totalGross = totalGrossAmount;
                const orderDiscount = Number(order.discountTotal || order.discount || 0);
                const finalTaxable = Math.max(0, totalGross - orderDiscount);
                const cgst = Number((finalTaxable * 0.015).toFixed(2));
                const sgst = Number((finalTaxable * 0.015).toFixed(2));
                const totalGST = Number((cgst + sgst).toFixed(2));

                // Round Off (manual adjustment if applied by employee)
                let roundOff = Number(order.roundOff || 0);
                if (!roundOff && order.notes && order.notes.includes('ROUND_OFF:')) {
                    const match = order.notes.match(/ROUND_OFF:([-0-9.]+)/);
                    if (match) roundOff = Number(match[1]);
                }

                const invoiceValue = Number((finalTaxable + totalGST + roundOff).toFixed(2));
                const netPayable = invoiceValue;

                // Fallback to reconstruct payments if order.payments is missing
                const displayPayments = (order.payments && order.payments.length > 0) ? order.payments : [];
                if (displayPayments.length === 0 && order) {
                    if (Number(order.cashPaid) > 0) displayPayments.push({ method: 'cash', amount: Number(order.cashPaid) });
                    if (Number(order.cardPaid) > 0) displayPayments.push({ method: 'card', amount: Number(order.cardPaid) });
                    if (Number(order.upiPaid) > 0) displayPayments.push({ method: 'upi', amount: Number(order.upiPaid) });

                    let parsedCreditMemos = [];
                    if (order.notes && order.notes.includes('PAYMENT_REF:credit_memo:')) {
                        const parts = order.notes.split('||');
                        for (const part of parts) {
                            if (part.startsWith('PAYMENT_REF:credit_memo:')) {
                                const subParts = part.split(':');
                                parsedCreditMemos.push({ method: 'credit_memo', referenceId: subParts[2], amount: Number(subParts[3] || 0) });
                            }
                        }
                    }

                    let parsedNeftPayments = [];
                    if (order.notes && (order.notes.includes('PAYMENT_REF:neft:') || order.notes.includes('PAYMENT_REF:rtgs:') || order.notes.includes('PAYMENT_REF:neft_rtgs:'))) {
                        const parts = order.notes.split('||');
                        for (const part of parts) {
                            if (part.startsWith('PAYMENT_REF:neft:') || part.startsWith('PAYMENT_REF:rtgs:') || part.startsWith('PAYMENT_REF:neft_rtgs:')) {
                                const subParts = part.split(':');
                                const method = part.startsWith('PAYMENT_REF:rtgs:') ? 'rtgs' : 'neft';
                                const utrNo = subParts[3] || subParts[2];
                                const amt = Number(subParts[4] || subParts[3] || 0);
                                parsedNeftPayments.push({ method, referenceId: utrNo, utrNumber: utrNo, amount: amt });
                            }
                        }
                    }

                    if (parsedCreditMemos.length > 0) {
                        displayPayments.push(...parsedCreditMemos);
                    } else if (Number(order.creditUsed) > 0) {
                        displayPayments.push({ method: 'credit_memo', amount: Number(order.creditUsed) });
                    }

                    if (parsedNeftPayments.length > 0) {
                        displayPayments.push(...parsedNeftPayments);
                    }
                }

                if (displayPayments.length === 0) {
                    displayPayments.push({
                        method: order.paymentMethod || 'Online',
                        referenceId: order.razorpayPaymentId || order.razorpayOrderId || '---',
                        amount: netPayable
                    });
                }

                const totalAdvanceAdjusted = Number(order.creditUsed || 0) > 0
                    ? Number(order.creditUsed)
                    : displayPayments
                        .filter(p => p.method === 'credit_memo')
                        .reduce((sum, p) => sum + Number(p.amount || 0), 0);
                const balancePayable = Math.max(0, netPayable - totalAdvanceAdjusted);
            %>

                <!-- Bottom Split Section -->
                <div class="flex border-b-invoice">
                    <!-- Left: Payments & Discounts -->
                    <div class="w-1/2 border-r-invoice">
                        <table class="w-full text-xs">
                            <thead class="border-b-invoice bg-gray-50">
                                <tr>
                                    <th class="text-left font-normal border-r-invoice">Payment</th>
                                    <th class="text-left font-normal border-r-invoice">Reference No</th>
                                    <th class="text-right font-normal">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% displayPayments.forEach(function(p) { %>
                                    <tr>
                                        <td class="border-r-invoice">
                                            <%= p.method === 'neft' ? 'NEFT (Bank Transfer)' : p.method === 'rtgs' ? 'RTGS (Bank Transfer)' : (p.method === 'neft_rtgs' || p.method === 'bank_transfer') ? 'NEFT / RTGS (Bank Transfer)' : p.method === 'credit_memo' ? 'Advance / Credit Note' : p.method.toUpperCase() %>
                                        </td>
                                        <td class="border-r-invoice">
                                            <%= p.utrNumber || p.referenceId || p.transactionId || '---' %>
                                        </td>
                                        <td class="text-right">
                                            <%= Number(p.amount || 0).toFixed(2) %>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                        <table class="w-full text-xs mt-4 border-t-invoice">
                            <thead class="border-b-invoice bg-gray-50">
                                <tr>
                                    <th class="text-left font-normal border-r-invoice">Discounts & Adjustments</th>
                                    <th class="text-right font-normal">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="border-r-invoice">Store Offer</td>
                                    <td class="text-right">
                                        <%= orderDiscount.toFixed(2) %>
                                    </td>
                                </tr>
                                <% if (totalAdvanceAdjusted > 0) { %>
                                    <tr>
                                        <td class="border-r-invoice text-red-600">Credit Amount</td>
                                        <td class="text-right text-red-600">
                                            <%= totalAdvanceAdjusted.toFixed(2) %>
                                        </td>
                                    </tr>
                                <% } %>
                                <tr class="border-t-invoice font-bold">
                                    <td class="border-r-invoice text-center">Total</td>
                                    <td class="text-right">
                                        <%= (orderDiscount + totalAdvanceAdjusted).toFixed(2) %>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Right: Tax Summary -->
                    <div class="w-1/2">
                        <table class="w-full text-xs">
                            <tbody>
                                <tr>
                                    <td class="py-1 px-2 border-b-invoice border-r-invoice">Gross Amount:</td>
                                    <td class="py-1 px-2 border-b-invoice text-right">
                                        <%= totalGross.toFixed(2) %>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="py-1 px-2 border-b-invoice border-r-invoice text-red-600">Total Discount:</td>
                                    <td class="py-1 px-2 border-b-invoice text-right text-red-600">
                                        -<%= orderDiscount.toFixed(2) %>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="py-1 px-2 border-b-invoice border-r-invoice font-semibold">Taxable Value:</td>
                                    <td class="py-1 px-2 border-b-invoice text-right font-semibold">
                                        <%= finalTaxable.toFixed(2) %>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="py-1 px-2 border-b-invoice border-r-invoice">CGST 1.5%:</td>
                                    <td class="py-1 px-2 border-b-invoice text-right">
                                        <%= cgst.toFixed(2) %>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="py-1 px-2 border-b-invoice border-r-invoice">SGST 1.5%:</td>
                                    <td class="py-1 px-2 border-b-invoice text-right">
                                        <%= sgst.toFixed(2) %>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="py-1 px-2 border-b-invoice border-r-invoice">Total GST (3%):</td>
                                    <td class="py-1 px-2 border-b-invoice text-right">
                                        <%= totalGST.toFixed(2) %>
                                    </td>
                                </tr>
                                <% if (roundOff !== 0) { %>
                                <tr>
                                    <td class="py-1 px-2 border-b-invoice border-r-invoice">
                                        Round off:
                                    </td>
                                    <td class="py-1 px-2 border-b-invoice text-right">
                                        <%= roundOff < 0 ? '-' + Math.abs(roundOff).toFixed(2) : '+' + roundOff.toFixed(2) %>
                                    </td>
                                </tr>
                                <% } %>
                                <tr class="font-bold bg-gray-50">
                                    <td class="py-2 px-2 border-b-invoice border-r-invoice">Invoice Total:</td>
                                    <td class="py-2 px-2 border-b-invoice text-right text-sm">
                                        <%= netPayable.toFixed(2) %>
                                    </td>
                                </tr>
                                <% if (totalAdvanceAdjusted > 0) { %>
                                    <tr class="text-red-600">
                                        <td class="py-1 px-2 border-b-invoice border-r-invoice font-semibold">Credit Amount Applied:</td>
                                        <td class="py-1 px-2 border-b-invoice text-right font-semibold">
                                            -<%= totalAdvanceAdjusted.toFixed(2) %>
                                        </td>
                                    </tr>
                                    <tr class="font-black bg-gray-100">
                                        <td class="py-2 px-2 border-b-invoice border-r-invoice">Net Payable:</td>
                                        <td class="py-2 px-2 border-b-invoice text-right text-sm">
                                            <%= balancePayable.toFixed(2) %>
                                        </td>
                                    </tr>
                                <% } %>
                                <tr>
                                    <td colspan="2" class="py-2 px-2 text-right italic">
                                        <span class="float-left not-italic">Amount In Words</span>
                                        <%= typeof amountInWords !== 'undefined' ? amountInWords : '' %>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Declarations -->
                <div class="p-2 text-[8px] leading-tight border-b-invoice">
                    <div class="flex justify-between font-bold mb-1">
                        <span>Declaration</span>
                        <span>*E&OE*</span>
                    </div>
                    <ol class="list-decimal pl-4 space-y-0.5">
                        <li>Total Invoice Value includes Metal Cost, Stone Cost (Precious, Non-Precious), Wastage
                            charges, Making Charges including Hall Marking(HM), GST, other taxes (as applicable) and
                            applicable discounts.</li>
                        <li>Product Value is inclusive of Hallmarking Charges(HM) of Rs.45/- per piece for Gold &
                            Rs.35/- per piece for Silver.</li>
                        <li>Gross weight includes the total weight of the product including metal, stones etc.</li>
                        <li>Net weight of metal(s) include the total weight of all metal(s) which are part of the
                            product.</li>
                        <li>Net weight of stone(s) include the total weight of all Precious, Non-Precious stone(s) which
                            are part of the product.</li>
                        <li>The Certificate of Authenticity has been issued for the invoiced products and handed over to
                            the customer.</li>
                        <li>The consumer can get the purity of the Hallmarked jewellery/articles verified from any of
                            the BIS recognised A & H Centre.</li>
                        <li>The list of A & H recognised centre along with address and contact details is available on
                            the website www.bis.gov.in.</li>
                    </ol>
                    <div class="mt-2 font-bold p-1 border border-black bg-gray-50">
                        I hereby confirm the weight, purity and Invoice value stated above and read all terms and
                        conditions overleaf. I further acknowledge the receipt of the products in good condition along
                        with necessary certificates.
                    </div>
                </div>

                <!-- Signatures -->
                <div class="flex justify-end p-4 pt-12">
                    <div class="text-xs">
                        <div class="flex items-center gap-4 mb-8">
                            <span class="w-28 text-right">Customer Name :</span>
                            <span class="font-bold border-b border-black w-40 text-center">
                                <%= order.user ? order.user.name : (shippingAddress.name || 'Guest' ) %>
                            </span>
                        </div>
                        <div class="text-right pr-20">Customer Signature</div>
                    </div>
                </div>

        </div>
    </div>

</body>

</html>